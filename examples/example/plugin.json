{
  "id": "example",
  "name": { "en": "Example plugin", "de": "Beispiel-Plugin" },
  "version": "1.2.0",
  "author": "TouchDeck",
  "license": "MIT",
  "description": {
    "en": "Shows how plugins work: own actions, a trigger, a timer, values and settings.",
    "de": "Zeigt, wie Plugins funktionieren: eigene Aktionen, ein Auslöser, ein Zeitgeber, Werte und Einstellungen."
  },
  "main": "plugin.js",
  "permissions": {
    "http": ["api.github.com"],
    "values": true,
    "notify": false
  },
  "settings": [
    { "key": "greeting", "label": { "en": "Greeting", "de": "Begrüßung" }, "type": "text", "default": "Hello" }
  ],
  "actions": [
    {
      "id": "greet",
      "label": { "en": "Greet", "de": "Begrüßen" },
      "icon": "👋",
      "fields": [{ "key": "name", "label": { "en": "Name ({Value} works)", "de": "Name ({Wert} möglich)" }, "type": "text" }]
    },
    {
      "id": "count",
      "label": { "en": "Count up by 1", "de": "Zähler um 1 erhöhen" },
      "icon": "🔢",
      "fields": [{ "key": "value", "label": { "en": "Value", "de": "Wert" }, "type": "dynamic", "source": "variables", "allowNew": true }]
    },
    {
      "id": "stars",
      "label": { "en": "Get GitHub stars", "de": "GitHub-Sterne abfragen" },
      "icon": "⭐",
      "fields": [{ "key": "repo", "label": { "en": "Repo (owner/name)", "de": "Repo (besitzer/name)" }, "type": "text" }]
    },
    {
      "id": "repo",
      "label": { "en": "Repo numbers (as data)", "de": "Repo-Zahlen (als Daten)" },
      "icon": "📊",
      "fields": [
        { "key": "repo", "label": { "en": "Repo (owner/name)", "de": "Repo (besitzer/name)" }, "type": "text" }
      ],
      "returns": [
        { "key": "stars", "label": { "en": "Stars", "de": "Sterne" }, "unit": "number" },
        { "key": "forks", "label": "Forks", "unit": "number" },
        { "key": "issues", "label": { "en": "Open issues", "de": "Offene Issues" }, "unit": "number" },
        { "key": "size", "label": { "en": "Size", "de": "Größe" }, "unit": "kb" }
      ]
    }
  ],
  "triggers": [
    {
      "id": "ten",
      "label": { "en": "Counter reached a multiple of 10", "de": "Zähler erreicht ein Vielfaches von 10" },
      "icon": "🎯",
      "fields": [{ "key": "value", "label": { "en": "Value (empty = any)", "de": "Wert (leer = jeder)" }, "type": "text" }]
    }
  ]
}
