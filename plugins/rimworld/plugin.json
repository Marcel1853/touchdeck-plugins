{
  "id": "rimworld",
  "name": "RimWorld",
  "version": "0.2.2",
  "author": "Marcel1853",
  "license": "MIT",
  "platforms": [
    "linux",
    "windows"
  ],
  "description": {
    "en": "RimWorld on your buttons: date, speed, mood, silver, research and threat live; pause, speed 1–4, save, screenshot, draft all, jump to colonists or the last letter, in-game messages, main tabs and research. Letters, raids, deaths, mental breaks and finished research as events. Needs the included RimWorld mod “TouchDeck Bridge” (local TCP connection, nothing goes to the internet). Advanced plugin (Python), with ready-made pages.",
    "de": "RimWorld auf deinen Buttons: Datum, Tempo, Stimmung, Silber, Forschung und Bedrohung live; Pause, Tempo 1–4, Speichern, Screenshot, alle einziehen, Kamera zu Kolonisten oder zum letzten Brief, Nachrichten im Spiel, Hauptreiter und Forschung. Briefe, Überfälle, Todesfälle, Nervenzusammenbrüche und fertige Forschung als Auslöser. Braucht den mitgelieferten RimWorld-Mod „TouchDeck Bridge“ (lokale TCP-Verbindung, nichts geht ins Internet). Erweitertes Plugin (Python), mit fertigen Seiten."
  },
  "native": {
    "command": [
      "python3",
      "plugin.py"
    ]
  },
  "mods": [
    {
      "name": "TouchDeck Bridge",
      "file": "TouchDeckBridge_*.zip",
      "unpack": true,
      "targets": {
        "linux": [
          "{steamGame:294100}/Mods"
        ],
        "windows": [
          "{steamGame:294100}/Mods"
        ]
      },
      "hint": {
        "en": "In RimWorld, switch on “TouchDeck Bridge” under Mods (after Harmony) and restart.",
        "de": "In RimWorld unter „Mods“ „TouchDeck Bridge“ einschalten (nach Harmony) und neu starten."
      }
    }
  ],
  "settings": [
    {
      "key": "host",
      "label": {
        "en": "RimWorld address (127.0.0.1 = this PC)",
        "de": "Adresse von RimWorld (127.0.0.1 = dieser PC)"
      },
      "type": "text",
      "default": "127.0.0.1"
    },
    {
      "key": "port",
      "label": {
        "en": "Port (as in the mod settings, 1024–65535)",
        "de": "Port (wie in den Mod-Einstellungen, 1024–65535)"
      },
      "type": "number",
      "default": 34200
    },
    {
      "key": "secret",
      "label": {
        "en": "Secret (as in the mod settings; required if the address is not 127.0.0.1, at least 12 characters)",
        "de": "Geheimwort (wie in den Mod-Einstellungen; Pflicht, wenn die Adresse nicht 127.0.0.1 ist, mindestens 12 Zeichen)"
      },
      "type": "password",
      "default": ""
    },
    {
      "key": "timeout",
      "label": {
        "en": "Wait for the game's answer at most … seconds (2–60)",
        "de": "Auf Antwort des Spiels höchstens … Sekunden warten (2–60)"
      },
      "type": "number",
      "default": 5
    }
  ],
