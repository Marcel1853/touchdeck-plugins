<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Captain-of-Industry-Mod „TouchDeck Bridge“. Ergebnis: ../../TouchDeckBridge.dll (Aufruf: ../../build.sh).

    Alle Verweise kommen aus der eigenen Installation von Captain of Industry (genau die Version, die gespielt
    wird), auch mscorlib und netstandard – damit passt alles zur Laufzeit des Spiels und nichts muss
    heruntergeladen werden. Nichts davon wird mitgeliefert (Private=false). Pfad über COI_ROOT änderbar:
      dotnet build -p:CoiRoot=/pfad/zu/Captain\ of\ Industry
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>TouchDeckBridge</AssemblyName>
    <RootNamespace>TouchDeckBridge</RootNamespace>
    <Version>0.1.0</Version>
    <OutputPath>../../</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <CoiRoot Condition="'$(CoiRoot)' == ''">$(COI_ROOT)</CoiRoot>
    <CoiRoot Condition="'$(CoiRoot)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Captain of Industry</CoiRoot>
    <Managed>$(CoiRoot)/Captain of Industry_Data/Managed</Managed>
    <FrameworkPathOverride>$(Managed)</FrameworkPathOverride>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="../Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <GameRef Include="mscorlib;netstandard;System;System.Core;UnityEngine.CoreModule;Mafi;Mafi.Core;Mafi.Unity" />
    <Reference Include="@(GameRef)">
      <HintPath>$(Managed)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
