{
  "id": "factorio",
  "name": "Factorio",
  "version": "0.3.0",
  "author": "Marcel1853",
  "license": "MIT",
  "description": {
    "en": "Factorio on your buttons: live research, speed, evolution, power (with graphs), planet; pause, speed, save, screenshot, quick chat and research queue. Needs the Factorio mod “TouchDeck Bridge”. No launch options, no network: the mod writes a JSON file, the plugin watches it.",
    "de": "Factorio auf deinen Buttons: Forschung live, Geschwindigkeit, Evolution, Strom (mit Graphen), Planet; Pause, Tempo, Speichern, Screenshot, Schnell-Chat und Forschungs-Warteschlange. Braucht den Factorio-Mod „TouchDeck Bridge“. Keine Startoptionen, kein Netzwerk: Der Mod schreibt eine JSON-Datei, das Plugin achtet auf Änderungen."
  },
  "native": {
    "command": [
      "python3",
      "plugin.py"
    ]
  },
  "settings": [
    {
      "key": "folder",
      "label": {
        "en": "Folder of the mod files (empty = find automatically)",
        "de": "Ordner der Mod-Dateien (leer = automatisch suchen)"
      },
      "type": "text",
      "default": ""
    },
    {
      "key": "interval",
      "label": {
        "en": "Check files every … ms (100–5000)",
        "de": "Dateien prüfen alle … ms (100–5000)"
      },
      "type": "number",
      "default": 250
    },
    {
      "key": "timeout",
      "label": {
        "en": "No data for … seconds = not connected (2–60)",
        "de": "Keine Daten seit … Sekunden = nicht verbunden (2–60)"
      },
      "type": "number",
      "default": 5
    }
  ],
  "actions": [
    {
      "id": "await",
      "label": {
        "en": "Wait for the game's answer",
        "de": "Auf Antwort des Spiels warten"
      },
      "icon": "⏳",
      "fields": [
        {
          "key": "cmd",
          "label": {
            "en": "Command (empty = any)",
            "de": "Befehl (leer = jeder)"
          },
          "type": "select",
          "default": "",
          "options": [
            {
              "value": "",
              "label": {
                "en": "Any",
                "de": "Jeder"
              }
            },
            {
              "value": "pause",
              "label": {
                "en": "Pause (toggle)",
                "de": "Pause (umschalten)"
              }
            },
            {
              "value": "speed",
              "label": {
                "en": "Speed",
                "de": "Geschwindigkeit"
              }
            },
            {
              "value": "save",
              "label": {
                "en": "Save game",
                "de": "Spiel speichern"
              }
            },
            {
              "value": "screenshot",
              "label": {
                "en": "Screenshot",
                "de": "Screenshot"
              }
            },
            {
              "value": "chat",
              "label": {
                "en": "Chat message",
                "de": "Chat-Nachricht"
              }
            },
            {
              "value": "quickchat",
              "label": {
                "en": "Quick chat",
                "de": "Schnell-Chat"
              }
            },
            {
              "value": "research",
              "label": {
                "en": "Queue research",
                "de": "Forschung einreihen"
              }
            },
            {
              "value": "cancel",
              "label": {
                "en": "Cancel research",
                "de": "Forschung abbrechen"
              }
            },
            {
              "value": "center",
              "label": {
                "en": "Back to the player",
                "de": "Zurück zum Spieler"
              }
            },
            {
              "value": "refresh",
              "label": {
                "en": "Write data again",
                "de": "Daten neu schreiben"
              }
            },
            {
              "value": "utl",
              "label": {
                "en": "UTL manager",
                "de": "UTL-Manager"
              }
            }
          ]
        },
        {
          "key": "seconds",
          "label": {
            "en": "Wait at most … seconds",
            "de": "Höchstens … Sekunden warten"
          },
          "type": "number",
          "default": 3
        }
      ]
    },
    {
      "id": "item",
      "label": {
        "en": "Production slot: choose item",
        "de": "Produktions-Platz: Item wählen"
      },
      "icon": "📦",
      "fields": [
        {
          "key": "slot",
          "label": {
            "en": "Slot (1–8)",
            "de": "Platz (1–8)"
          },
          "type": "number",
          "default": 1
        },
        {
          "key": "op",
          "label": {
            "en": "What",
            "de": "Was"
          },
          "type": "select",
          "default": "next",
          "options": [
            {
              "value": "next",
              "label": {
                "en": "Next item",
                "de": "Nächstes Item"
              }
            },
            {
              "value": "prev",
              "label": {
                "en": "Previous item",
                "de": "Voriges Item"
              }
            },
            {
              "value": "auto",
              "label": {
                "en": "Automatic (most produced)",
                "de": "Automatisch (meistproduziert)"
              }
            },
            {
              "value": "set",
              "label": {
                "en": "Choose by name",
                "de": "Nach Name wählen"
              }
            },
            {
              "value": "all_auto",
              "label": {
                "en": "All slots automatic",
                "de": "Alle Plätze automatisch"
              }
            }
          ]
        },
        {
          "key": "value",
          "label": {
            "en": "Name (in game language or internal)",
            "de": "Name (Spielsprache oder intern)"
          },
          "type": "text",
          "default": "",
          "placeholder": {
            "en": "e.g. Iron plate or iron-plate",
            "de": "z. B. Eisenplatte oder iron-plate"
          },
          "showIf": {
            "op": [
              "set"
            ]
          }
        }
      ]
    }
  ],
