{
  "id": "factorio",
  "name": "Factorio",
  "version": "0.8.0",
  "author": "Marcel1853",
  "license": "MIT",
  "platforms": [
    "linux",
    "windows"
  ],
  "description": {
    "en": "Factorio on your buttons: live research, speed, evolution, power and production (with graphs), planet, UTLogistics trains; pause, speed, save, screenshot and research queue. Needs the Factorio mod “TouchDeck Bridge” (mod portal). No launch options, no network: the mod writes JSON files, the plugin watches them.",
    "de": "Factorio auf deinen Buttons: Forschung, Geschwindigkeit, Evolution, Strom und Produktion live (mit Graphen), Planet, UTLogistics-Züge; Pause, Tempo, Speichern, Screenshot und Forschungs-Warteschlange. Braucht den Factorio-Mod „TouchDeck Bridge“ (Mod-Portal). Keine Startoptionen, kein Netzwerk: Der Mod schreibt JSON-Dateien, das Plugin achtet auf Änderungen.",
    "fr": "Factorio sur vos boutons : recherche, vitesse, évolution, électricité et production en direct (avec graphiques), planète, trains UTLogistics ; pause, vitesse, sauvegarde, capture d'écran et file de recherche. Nécessite le mod Factorio « TouchDeck Bridge » (portail des mods). Sans option de lancement, sans réseau : le mod écrit des fichiers JSON, le plugin les surveille.",
    "es": "Factorio en tus botones: investigación, velocidad, evolución, electricidad y producción en directo (con gráficos), planeta, trenes de UTLogistics; pausa, velocidad, guardar, captura y cola de investigación. Necesita el mod de Factorio «TouchDeck Bridge» (portal de mods). Sin opciones de inicio, sin red: el mod escribe archivos JSON y el plugin los vigila.",
    "pl": "Factorio na twoich przyciskach: badania, prędkość, ewolucja, prąd i produkcja na żywo (z wykresami), planeta, pociągi UTLogistics; pauza, prędkość, zapis, zrzut ekranu i kolejka badań. Wymaga moda do Factorio „TouchDeck Bridge” (portal modów). Bez opcji uruchamiania, bez sieci: mod zapisuje pliki JSON, plugin je obserwuje.",
    "pt-br": "Factorio nos seus botões: pesquisa, velocidade, evolução, energia e produção ao vivo (com gráficos), planeta, trens do UTLogistics; pausa, velocidade, salvar, captura de tela e fila de pesquisa. Precisa do mod de Factorio “TouchDeck Bridge” (portal de mods). Sem opções de inicialização, sem rede: o mod grava arquivos JSON e o plugin os observa.",
    "ru": "Factorio на ваших кнопках: исследования, скорость, эволюция, энергия и производство в реальном времени (с графиками), планета, поезда UTLogistics; пауза, скорость, сохранение, снимок экрана и очередь исследований. Нужен мод Factorio «TouchDeck Bridge» (портал модов). Без параметров запуска, без сети: мод пишет JSON-файлы, плагин следит за ними.",
    "zh-cn": "在按钮上显示 Factorio：实时显示研究、速度、进化度、电力和生产（含图表）、星球、UTLogistics 列车；暂停、调速、保存、截图和研究队列。需要 Factorio 模组“TouchDeck Bridge”（模组门户）。无需启动参数，无需网络：模组写入 JSON 文件，插件监视这些文件。"
  },
  "native": {
    "command": [
      "python3",
      "plugin.py"
    ]
  },
  "mods": [
    {
      "name": "TouchDeck Bridge",
      "file": "touchdeck-bridge_*.zip",
      "conflicts": [
        "touchdeck-bridge"
      ],
      "targets": {
        "linux": [
          "{home}/.factorio/mods",
          "{home}/.var/app/com.valvesoftware.Steam/.factorio/mods"
        ],
        "windows": [
          "{appdata}/Factorio/mods"
        ],
        "proton": [
          "{proton:427520}/AppData/Roaming/Factorio/mods"
        ]
      },
      "hint": {
        "en": "Restart Factorio – new mods are switched on automatically.",
        "de": "Factorio neu starten – neue Mods sind automatisch an.",
        "fr": "Redémarrez Factorio – les nouveaux mods sont activés automatiquement.",
        "es": "Reinicia Factorio: los mods nuevos se activan automáticamente.",
        "pl": "Uruchom ponownie Factorio – nowe mody włączają się automatycznie.",
        "pt-br": "Reinicie o Factorio – mods novos são ativados automaticamente.",
        "ru": "Перезапустите Factorio – новые моды включаются автоматически.",
        "zh-cn": "重启 Factorio——新模组会自动启用。"
      }
    }
  ],
